<?xml version="1.0"?>
<ruleset name="JGOR Compatibility Fix for Safe SVG"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">

	<description>WordPress Coding Standards für das Plugin Compatibility Fix for Safe SVG (Prefix compatibility_fix_for_safe_svg).</description>

	<!-- Zu prüfende Dateien: das Plugin selbst -->
	<file>plugin</file>

	<!-- Ausschlüsse -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/stubs/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>

	<!-- Laufzeitoptionen: nur PHP, Sniff-Codes anzeigen, Fortschritt, Farben, parallel, Cache -->
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>

	<!-- Zielversionen (siehe Plugin-Header: Requires PHP 7.4, Requires at least 6.5) -->
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="6.5"/>

	<!-- Vollständiger WordPress-Standard (Core, Docs, Extra) -->
	<rule ref="WordPress"/>

	<!-- PHP-Kompatibilität ab testVersion -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- Prefix-Prüfung: Funktionen compatibility_fix_for_safe_svg_ (Prefix seit 1.0.0, bleibt
	     wegen der veröffentlichten Hook-Namen) -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="compatibility_fix_for_safe_svg"/>
			</property>
		</properties>
	</rule>

	<!-- Text-Domain = Plugin-Slug -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="compatibility-fix-for-safe-svg"/>
			</property>
		</properties>
	</rule>

</ruleset>
